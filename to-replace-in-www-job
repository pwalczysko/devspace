node('testintegration') {

    library identifier: 'recursiveMerge@master', retriever: modernSCM(
        [$class: 'GitSCMSource',
         remote: 'https://github.com/ome/jenkins-library-recursivemerge.git'])

    recursiveCheckout(
        repo: 'www.openmicroscopy.org'
    )

    recursiveMerge(
        baseRepo: 'www.openmicroscopy.org'
    )

    dir('_governance') {
        sh '''
            git branch -D pr-3 2>/dev/null || true
            git fetch origin pull/3/head:pr-3
            git checkout pr-3

            echo "Using governance PR:"
            git rev-parse HEAD
            git log -1 --oneline
        '''
    }
}