node('testintegration') {

    library identifier: 'recursiveMerge@master', retriever: modernSCM(
        [$class: 'GitSCMSource',
         remote: 'https://github.com/ome/jenkins-library-recursivemerge.git'])

    recursiveCheckout(
        repo: 'www.openmicroscopy.org')

    dir('governance') {
        sh """
            git fetch origin pull/123/head:pr-123
            git checkout pr-123
        """
    }

    recursiveMerge(
        baseRepo: 'www.openmicroscopy.org')
}